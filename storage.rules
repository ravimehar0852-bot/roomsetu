rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Property photos: listings/{ownerUid}/{listingId}/{fileName}
    // Public can view photos; only the owner can upload/delete in their own folder.
    match /listings/{ownerUid}/{listingId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Owner verification documents (private) - kept from your existing rules
    match /verification/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.admin == true);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy public files - kept from your existing rules
    match /public/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{path=**} { allow read, write: if false; }
  }
}
