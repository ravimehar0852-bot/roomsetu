rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasUserDoc() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true || (hasUserDoc() && userDoc().role == "admin"));
    }
    // "worker" kept as an accepted legacy alias for owner (harmless on a fresh project)
    function isOwnerRole() { return hasUserDoc() && userDoc().role in ["owner", "worker"]; }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if isAdmin() || isSelf(uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSelf(uid) && request.resource.data.role in ["customer", "owner", "worker"]);
      allow update: if isAdmin() || (isSelf(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---------- listings ----------
    match /listings/{listingId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (resource.data.status == "approved" && resource.data.availability == "available");

      allow create: if isOwnerRole()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "approved"
        && request.resource.data.availability == "available"
        && request.resource.data.title is string && request.resource.data.title.size() > 2
        && request.resource.data.monthlyRent is number && request.resource.data.monthlyRent > 0
        && request.resource.data.securityDeposit is number && request.resource.data.securityDeposit >= 0
        && request.resource.data.description is string
        && request.resource.data.photos is list && request.resource.data.photos.size() == 0
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31, "d")
        && request.resource.data.keys().hasOnly([
          "ownerUid","ownerName","ownerEmail","title","propertyType","propertyTypeLabel",
          "roomTypeLabel","suitableFor","suitableForLabel","monthlyRent","securityDeposit","availableFrom",
          "furnishing","furnishingLabel","country","state","city","area","landmark","facilities",
          "description","latitude","longitude","locationAccuracy","photos","status","availability","createdAt","expiresAt"]);

      // Owner A: add photos / toggle availability (status untouched)
      allow update: if isOwnerRole() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photos","availability"])
        && request.resource.data.availability in ["available","unavailable"]
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 8;

      // Owner B: edit details (status stays as the admin set it; owner can never change status/expiry/pin)
      allow update: if isOwnerRole() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title","propertyType","propertyTypeLabel","roomTypeLabel","suitableFor","suitableForLabel",
          "monthlyRent","securityDeposit","availableFrom","furnishing","furnishingLabel","area","landmark",
          "facilities","description","latitude","longitude","locationAccuracy","ownerName"])
        && request.resource.data.monthlyRent is number && request.resource.data.monthlyRent > 0;

      // Admin: remove / restore, set live duration (expiresAt), pin to top (featuredRank)
      allow update: if isAdmin()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ["approved","rejected","pending"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","reviewedAt","expiresAt","featuredRank"])
        && (!("featuredRank" in request.resource.data) || request.resource.data.featuredRank is number);

      allow delete: if isAdmin();
    }

    // ---------- enquiries ----------
    match /enquiries/{id} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.listingId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 1000
        && request.resource.data.customerName is string
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == "approved"
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerUid == request.resource.data.ownerUid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.keys().hasOnly(["listingId","listingTitle","ownerUid","customerUid","customerName","customerContact","message","status","createdAt"]);

      // owner moves enquiry status only
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.status in ["new","contacted","closed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","updatedAt"]);
      allow delete: if isAdmin();
    }

    // ---------- chats (id = listingId_customerUid) ----------
    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      allow list: if signedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if signedIn()
        && chatId == request.resource.data.listingId + "_" + request.auth.uid
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.participants == [request.resource.data.ownerUid, request.auth.uid]
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerUid == request.resource.data.ownerUid
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == "approved"
        && request.resource.data.keys().hasOnly(["listingId","listingTitle","ownerUid","ownerName","customerUid","customerName","participants","lastMessage","lastMessageAt","createdAt"]);
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage","lastMessageAt"])
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 200;
      allow delete: if isAdmin();

      match /messages/{mid} {
        allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(["senderUid","text","createdAt"]);
        allow delete: if isAdmin();
      }
    }

    // ---------- favorites (doc id = uid_listingId) ----------
    match /favorites/{favId} {
      allow get, delete: if signedIn() && favId.matches(request.auth.uid + "_.*");
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.listingId is string
        && favId == request.auth.uid + "_" + request.resource.data.listingId
        && request.resource.data.keys().hasOnly(["uid","listingId","createdAt"]);
      allow update: if false;
    }

    // ---------- notifications (created by admin/backend only) ----------
    match /notifications/{id} {
      allow get, list: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAdmin();
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if isAdmin() || (signedIn() && resource.data.recipientUid == request.auth.uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
